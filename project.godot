; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Connect4"
run/main_scene="res://scenes/scene_manager.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/stretch/mode="canvas_items"
config/size/resizable=true

[autoload]

Constants="*res://scripts/constants.gd"
SignalBus="*res://scripts/signal_bus.gd"
Connect="*res://scripts/connect.gd"

[debug]

file_logging/enable_file_logging=true
gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

click={
"deadzone": 0.5,
